rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;
    }

    // Interventions
    match /interventions/{interventionId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(interventionId);
      allow delete: if isSignedIn() && isValidId(interventionId);
    }

    // Alerts
    match /alerts/{alertId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && isValidId(alertId);
    }

    // AI Insights generated by Gemini
    match /ai_insights/{insightId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && isValidId(insightId);
    }

    // Student Activities & Knowledge Improvement Plans
    match /student_activities/{activityId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && isValidId(activityId);
    }

    // News
    match /news/{document=**} {
      allow read, write: if true;
    }

    // Students & Leaderboard
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(studentId);
      allow delete: if false;
    }

    // Staff
    match /staff/{staffId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(staffId);
      allow delete: if false;
    }

    // AI Chat History
    match /ai_chats/{chatId} {
      allow read, create, update: if isSignedIn();
    }
  }
}
